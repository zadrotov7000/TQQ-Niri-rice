{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 7,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 5,
  "modules-left": ["custom/launcher", "niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "disk", "custom/notification", "network", "pulseaudio", "battery", "tray"],
  "custom/launcher": {
    "format": "󰍉",
    "tooltip": true,
    "tooltip-format": "Search applications",
    "on-click": "fuzzel"
  },
  "niri/workspaces": {
    "format": "{icon}",
    "sort-by-id": true,
    "all-outputs": true,
    "format-icons": {
      "focused": "●",
      "active": "●",
      "default": "○",
      "empty": "○",
      "urgent": "!"
    },
    "on-click": "activate"
  },
  "clock": {
    "format": "󰥔  {:%H:%M}   󰃭  {:%d %b}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\\n<tt>{:%H:%M:%S}</tt>"
  },
  "cpu": {\n    "format": "󰍛  {usage}%",\n    "interval": 3,\n    "tooltip": true\n  },\n  "memory": {\n    "format": "󰘚  {percentage}%",\n    "interval": 5,\n    "tooltip": true\n  },\n  "disk": {\n    "path": "/",\n    "format": "󰋊  {percentage_used}%",\n    "interval": 30,\n    "tooltip": true\n  },\n  "pulseaudio": {
    "format": "󰕾  {volume}%",
    "format-muted": "󰖁  muted",
    "tooltip": true,
    "scroll-step": 5,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀  LAN",
    "format-disconnected": "󰖪  offline",
    "tooltip-format": "{essid}: {ipaddr}/{cidr}",
    "interval": 5
  },
  "battery": {
    "format": "󰁹  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  AC",
    "states": {"warning": 30, "critical": 15},
    "tooltip": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 7,
    "show-passive-items": true,
    "tooltip": true
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}