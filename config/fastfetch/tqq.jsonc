{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "debian",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "38;2;237;169;187",
      "output": "38;2;241;234;241"
    },
    "percent": {
      "type": [
        "num"
      ]
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭───────────────────────────────────────────╮",
      "outputColor": "38;2;237;169;187",
      "key": " "
    },
    {
      "type": "os",
      "key": "│ OS       → ",
      "format": "{pretty-name<30} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "kernel",
      "key": "│ Kernel   → ",
      "format": "{release<30} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "shell",
      "key": "│ Shell    → ",
      "format": "{pretty-name<8}{version<22} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "custom",
      "format": "╰───────────────────────────────────────────╯",
      "outputColor": "38;2;237;169;187",
      "key": " "
    },
    "break",
    {
      "type": "custom",
      "format": "╭───────────────────────────────────────────╮",
      "outputColor": "38;2;237;169;187",
      "key": " "
    },
    {
      "type": "terminal",
      "key": "│ Terminal → ",
      "format": "{pretty-name<12}{version<18} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "wm",
      "key": "│ WM       → ",
      "format": "{pretty-name<30} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "custom",
      "format": "╰───────────────────────────────────────────╯",
      "outputColor": "38;2;237;169;187",
      "key": " "
    },
    "break",
    {
      "type": "custom",
      "format": "╭───────────────────────────────────────────╮",
      "outputColor": "38;2;237;169;187",
      "key": " "
    },
    {
      "type": "cpu",
      "key": "│ CPU      → ",
      "format": "{name<30} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "gpu",
      "key": "│ GPU      → ",
      "format": "{name<30} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "custom",
      "format": "╰───────────────────────────────────────────╯",
      "outputColor": "38;2;237;169;187",
      "key": " "
    },
    "break",
    {
      "type": "custom",
      "format": "╭───────────────────────────────────────────╮",
      "outputColor": "38;2;237;169;187",
      "key": " "
    },
    {
      "type": "memory",
      "key": "│ RAM      → ",
      "format": "{used<10} / {total<10} {percentage<7} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "swap",
      "key": "│ Swap     → ",
      "format": "{used<10} / {total<10} {percentage<7} {#keys}│{#}",
      "keyColor": "38;2;237;169;187",
      "outputColor": "38;2;241;234;241",
      "keyWidth": 0
    },
    {
      "type": "custom",
      "format": "╰───────────────────────────────────────────╯",
      "outputColor": "38;2;237;169;187",
      "key": " "
    }
  ]
}
