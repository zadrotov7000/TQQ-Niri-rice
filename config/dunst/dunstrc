# Starter palette. Matugen replaces this config after wallpaper selection.
[global]
    origin = top-right
    offset = 14x64
    width = 340
    font = JetBrains Mono 10
    format = "<b>%s</b>\n%b"
    frame_width = 2
    corner_radius = 12
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    icon_position = left
    max_icon_size = 48
    notification_limit = 5
    history_length = 20

[urgency_low]
    background = "#111827"
    foreground = "#e5e7eb"
    frame_color = "#64748b"
    timeout = 4

[urgency_normal]
    background = "#111827"
    foreground = "#e5e7eb"
    frame_color = "#7c93de"
    timeout = 6

[urgency_critical]
    background = "#111827"
    foreground = "#ffffff"
    frame_color = "#ff6b8a"
    timeout = 0
