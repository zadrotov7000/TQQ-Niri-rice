# TQQ Dunst theme generated by Matugen.
[global]
    origin = top-right
    offset = 14x64
    width = 340
    font = JetBrains Mono 10
    format = "<b>%s</b>\n%b"
    frame_width = 2
    corner_radius = 12
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    icon_position = left
    max_icon_size = 48
    notification_limit = 5
    history_length = 20

[urgency_low]
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.secondary.default.hex}}"
    timeout = 4

[urgency_normal]
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.primary.default.hex}}"
    timeout = 6

[urgency_critical]
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.error.default.hex}}"
    timeout = 0
