#!/usr/bin/env bash
set -euo pipefail

# Rebuild ONLY TQQ Squishy shaders and apply its QML; never touch Niri/rice.
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="$ROOT/quickshell/tqq-squishy"
TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/tqq-squishy"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/tqq-niri-rice"
BACKUP="$STATE/backups/squishy-$(date +%Y%m%d-%H%M%S)-$$"

for file in shell.qml squishy.vert squishy.frag; do
    if [[ ! -s "$SOURCE/$file" ]]; then
        echo "Missing source: $SOURCE/$file" >&2
        exit 1
    fi
done

# Build first. If qsb is missing or shader code fails to compile, the active
# installation is left completely unchanged.
TMP="$(mktemp -d)"
trap 'rm -rf -- "$TMP"' EXIT
echo "Compiling TQQ Squishy GPU shaders..."
bash "$ROOT/scripts/build-squishy-shaders" "$SOURCE" "$TMP"

echo "Backing up existing Squishy files..."
mkdir -p "$BACKUP" "$TARGET"
for file in shell.qml squishy.vert.qsb squishy.frag.qsb; do
    if [[ -f "$TARGET/$file" ]]; then
        cp -p -- "$TARGET/$file" "$BACKUP/$file"
    fi
done

# Close an old Squishy overlay with Escape before updating; Quickshell
# reuses running instances and should load both new shaders together.
install -m 0644 "$SOURCE/shell.qml" "$TARGET/shell.qml"
install -m 0644 "$TMP/squishy.vert.qsb" "$TARGET/squishy.vert.qsb"
install -m 0644 "$TMP/squishy.frag.qsb" "$TARGET/squishy.frag.qsb"

echo "TQQ Squishy Physics updated."
echo "Backup: $BACKUP"
echo "Open Squishy with your existing Mod+F-family binding."
