#!/usr/bin/env bash
set -euo pipefail

# Update terminal selection and the Niri binding, not the entire rice.
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/tqq-niri-rice"
NIRI_CONFIG="$CONFIG_HOME/niri/config.kdl"
LOCAL_BIN="$HOME/.local/bin"
MODE="${1:---auto}"

case "$MODE" in --auto|--kitty|--ghostty) ;; *)
    echo "Usage: $0 [--auto|--kitty|--ghostty]" >&2; exit 2 ;;
esac

# Verify original before selecting a terminal or writing anything.
if [[ ! -f "$NIRI_CONFIG" || -L "$NIRI_CONFIG" ]]; then
    echo "Niri config missing or symlink-managed: $NIRI_CONFIG" >&2
    exit 1
fi
if ! command -v niri >/dev/null 2>&1; then
    echo "Cannot validate Niri configuration: niri is not installed." >&2
    exit 1
fi

bash "$ROOT/scripts/setup-default-terminal" "$MODE"

mkdir -p "$STATE_HOME/backups"
backup_dir="$STATE_HOME/backups/terminal-bind-$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$backup_dir"
cp -p -- "$NIRI_CONFIG" "$backup_dir/config.kdl"

# Same-directory candidate preserves relative Niri include resolution.
candidate="$(mktemp "$CONFIG_HOME/niri/.tqq-terminal-XXXXXXXX.kdl")"
trap 'rm -f -- "$candidate"' EXIT
cp -p -- "$NIRI_CONFIG" "$candidate"
# Only touch the requested Win+Enter shortcut; keep all existing other Niri
# shortcuts and TQQ generated sections byte-for-byte unchanged.
python3 - "$candidate" "$ROOT/scripts/integrate-niri.py" "$LOCAL_BIN/tqq-terminal" <<'PY'
from pathlib import Path
import importlib.util
import json
import re
import sys

path = Path(sys.argv[1])
spec = importlib.util.spec_from_file_location("tqq_niri", sys.argv[2])
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
text = path.read_text()
text = re.sub(
    r"(?ms)^[ \t]*// BEGIN TQQ TERMINAL BIND\n.*?^[ \t]*// END TQQ TERMINAL BIND[ \t]*(?:\n|$)",
    "",
    text,
)
text = module.remove_keybindings(
    text, ["Mod+Return", "Super+Return", "Mod+Enter", "Super+Enter"]
)
match = re.search(r"(?m)^[ \t]*binds[ \t]*\{", text)
if not match:
    raise SystemExit("No Niri binds block found; config is untouched.")
opening = text.find("{", match.start())
closing = module.find_block_end(text, opening)
binding = (
    '\n    // BEGIN TQQ TERMINAL BIND\n'
    '    Mod+Return hotkey-overlay-title="TQQ Terminal" { spawn '
    + json.dumps(sys.argv[3]) + '; }\n'
    '    // END TQQ TERMINAL BIND\n'
)
path.write_text(text[:closing] + binding + text[closing:])
PY
if ! niri validate --config "$candidate"; then
    echo "Niri validation failed; the existing config is untouched." >&2
    exit 1
fi
mv -f -- "$candidate" "$NIRI_CONFIG"
trap - EXIT
echo "Win+Enter now launches your selected TQQ terminal."
echo "Niri backup: $backup_dir/config.kdl"
