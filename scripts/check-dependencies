#!/usr/bin/env bash
set -u

required=(niri swaync swaync-client matugen quickshell playerctl wpctl pavucontrol nmcli blueman-manager brightnessctl curl python3 cargo rustc pkg-config pgrep pkill)
missing=()
for command_name in "${required[@]}"; do
    command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
done
if ! pkg-config --exists gtk4; then
    missing+=("GTK4 development files (gtk4 pkg-config module)")
fi
if ! pkg-config --exists gtk4-layer-shell-0; then
    missing+=("GTK4 Layer Shell development files (gtk4-layer-shell-0 pkg-config module)")
fi
if { ! command -v awww >/dev/null 2>&1 || ! command -v awww-daemon >/dev/null 2>&1; } \
    && ! command -v swaybg >/dev/null 2>&1; then
    missing+=("awww or swaybg")
fi

if ((${#missing[@]} == 0)); then
    echo "All required TQQ rice commands are available."
    exit 0
fi

printf 'Missing commands: %s\n' "${missing[*]}"
if [[ -r /etc/os-release ]]; then
    . /etc/os-release
    case "${ID:-}" in
        debian|ubuntu|linuxmint|pop)
            echo "Debian-family packages: quickshell (from trixie-backports), playerctl pavucontrol network-manager blueman brightnessctl lm-sensors, sway-notification-center cargo rustc pkg-config libgtk-4-dev libgtk4-layer-shell-dev pipewire-bin wireplumber swaybg fonts-font-awesome fonts-jetbrains-mono"
            echo "Matugen and awww may need their upstream release/package for your Debian version."
            ;;
        arch|endeavouros|manjaro)
            echo "Arch packages: quickshell playerctl pavucontrol networkmanager blueman brightnessctl lm_sensors swaync rust cargo pkgconf gtk4 gtk4-layer-shell matugen awww pipewire wireplumber"
            ;;
        fedora)
            echo "Fedora packages: quickshell playerctl pavucontrol NetworkManager-bluetooth blueman brightnessctl lm_sensors SwayNotificationCenter cargo rust gtk4-devel gtk4-layer-shell-devel pkgconf-pkg-config matugen awww pipewire wireplumber"
            ;;
        opensuse*|opensuse-tumbleweed|opensuse-leap)
            echo "openSUSE package names vary by release; search for NetworkManager-applet, blueman, pavucontrol, SwayNotificationCenter, Rust/Cargo, GTK4 and GTK4 Layer Shell development files, Matugen, awww and WirePlumber."
            ;;
        *)
            echo "Install equivalent packages for your distribution: SwayNC, Rust/Cargo, GTK4 and GTK4 Layer Shell development files, Matugen, PipeWire/WirePlumber and awww or swaybg."
            ;;
    esac
fi
exit 1
