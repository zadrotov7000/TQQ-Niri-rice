#!/usr/bin/env bash
set -u

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

required=(niri fastfetch flock dunst dunstctl waybar nm-applet blueman-applet fc-list fc-cache matugen quickshell playerctl wpctl pavucontrol nmcli blueman-manager brightnessctl curl python3 cargo rustc pkg-config pgrep pkill)
missing=()
for command_name in "${required[@]}"; do
    command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
done
if ! pkg-config --exists gtk4; then
    missing+=("GTK4 development files (gtk4 pkg-config module)")
fi
if ! pkg-config --exists gtk4-layer-shell-0; then
    missing+=("GTK4 Layer Shell development files (gtk4-layer-shell-0 pkg-config module)")
fi
if { ! command -v awww >/dev/null 2>&1 || ! command -v awww-daemon >/dev/null 2>&1; } \
    && { ! command -v swww >/dev/null 2>&1 || ! command -v swww-daemon >/dev/null 2>&1; }; then
    missing+=("awww or swww (animated wallpaper backend)")
fi

# Font Awesome is the default Waybar glyph font; Nerd Font is optional fallback.
if command -v fc-list >/dev/null 2>&1; then
    if ! fc-list -f '%{family}\n' | grep -E 'FontAwesome|Font Awesome' >/dev/null; then
        missing+=("FontAwesome icons (install fonts-font-awesome)")
    fi
fi

if ((${#missing[@]} == 0)); then
    echo "All required TQQ rice commands are available."
    exit 0
fi

printf 'Missing commands: %s\n' "${missing[*]}"
if [[ -r /etc/os-release ]]; then
    . /etc/os-release
    case "${ID:-}" in
        debian|ubuntu|linuxmint|pop)
            echo "Debian-family packages: quickshell (from trixie-backports), fastfetch playerctl pavucontrol network-manager blueman brightnessctl lm-sensors, dunst cargo rustc pkg-config libgtk-4-dev libgtk4-layer-shell-dev pipewire-bin wireplumber swaybg waybar network-manager-applet adwaita-icon-theme fontconfig fonts-font-awesome fonts-jetbrains-mono"
            echo "The installer builds a pinned swww release using existing Rust if no animated backend is installed."
            ;;
        arch|endeavouros|manjaro)
            echo "Arch packages: quickshell fastfetch playerctl pavucontrol networkmanager blueman brightnessctl lm_sensors dunst waybar ttf-nerd-fonts-symbols rust cargo pkgconf gtk4 gtk4-layer-shell matugen awww pipewire wireplumber"
            ;;
        fedora)
            echo "Fedora packages: quickshell fastfetch playerctl pavucontrol NetworkManager-bluetooth blueman brightnessctl lm_sensors dunst waybar network-manager-applet adwaita-icon-theme fontconfig cargo rust gtk4-devel gtk4-layer-shell-devel pkgconf-pkg-config matugen awww pipewire wireplumber"
            ;;
        opensuse*|opensuse-tumbleweed|opensuse-leap)
            echo "openSUSE packages: fastfetch, NetworkManager-applet, blueman, pavucontrol, dunst, Waybar, network applet, Nerd Font symbols, Rust/Cargo, GTK4 and GTK4 Layer Shell development files, Matugen, awww and WirePlumber."
            ;;
        *)
            echo "Install equivalent packages for your distribution: Dunst, Waybar, network applet, Nerd Font symbols, Rust/Cargo, GTK4 and GTK4 Layer Shell development files, Matugen, PipeWire/WirePlumber and awww or swww."
            ;;
    esac
fi
echo "For Waybar icons, install the Font Awesome font (Debian: fonts-font-awesome)."
exit 1
