#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

wallpaper_dir="${WALLPAPER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tqq-niri-rice/wallpapers}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}/tqq-niri-rice"
state_file="$state_home/current-wallpaper"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
matugen_config="$config_home/matugen/config.toml"
picker="${WALLPAPER_PICKER:-$HOME/.local/bin/tqq-wallpaper-gallery}"
wait_for_components=0

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "TQQ Niri rice" "$1" || true
}

set_wallpaper() {
    local image="$1"
    [[ -r "$image" ]] || { notify "Can't read wallpaper: $image"; return 1; }

    if command -v awww >/dev/null 2>&1; then
        if ! awww query >/dev/null 2>&1 && command -v awww-daemon >/dev/null 2>&1; then
            nohup awww-daemon >/dev/null 2>&1 </dev/null &
            local attempt
            for attempt in {1..30}; do
                awww query >/dev/null 2>&1 && break
                sleep 0.2
            done
        fi
        if awww query >/dev/null 2>&1 && awww img --transition-type center --transition-duration 0.95 --transition-fps 30 -- "$image"; then
            :
        elif command -v swaybg >/dev/null 2>&1; then
            pkill -x swaybg >/dev/null 2>&1 || true
            nohup swaybg -i "$image" -m fill >/dev/null 2>&1 </dev/null &
        else
            notify "awww is unavailable and swaybg is not installed."
            return 1
        fi
    elif command -v swaybg >/dev/null 2>&1; then
        pkill -x swaybg >/dev/null 2>&1 || true
        nohup swaybg -i "$image" -m fill >/dev/null 2>&1 </dev/null &
    else
        notify "Install awww or swaybg to display wallpapers."
        return 1
    fi

    mkdir -p "$state_home" "$config_home/tqq-niri-rice"
    printf '%s\n' "$image" > "$state_file"

    if ! command -v matugen >/dev/null 2>&1; then
        notify "Wallpaper changed, but Matugen is missing; colors were not updated."
        return 1
    fi
    if [[ ! -r "$matugen_config" ]]; then
        notify "Matugen config not found: $matugen_config"
        return 1
    fi
    matugen_log="$state_home/matugen.log"
    if ! matugen -c "$matugen_config" image "$image" -m dark --source-color-index 0 >"$matugen_log" 2>&1; then
        notify "Wallpaper changed, but Matugen failed. Details: $matugen_log"
        return 1
    fi

    if [[ ! -s "$config_home/waybar/colors.css" \
        || ! -s "$config_home/dunst/dunstrc" \
        || ! -s "$config_home/tqq-niri-rice/colors.json" ]] \
        || grep -q 'Starter palette' \
            "$config_home/waybar/colors.css" \
            "$config_home/dunst/dunstrc" \
            "$config_home/tqq-niri-rice/colors.json"; then
        notify "Matugen did not replace the starter colors. Check $matugen_log and $matugen_config."
        return 1
    fi

    if ((wait_for_components)); then
        local attempt
        for attempt in {1..30}; do
            pgrep -x waybar >/dev/null 2>&1 && break
            sleep 0.1
        done
    fi
    # Update the Niri border include from the same Matugen colors.
    # One Rust process per wallpaper change; no permanently running daemon.
    if [[ -x "$HOME/.local/bin/tqq-windowfx" ]]; then
        if ! "$HOME/.local/bin/tqq-windowfx" "$config_home/waybar/colors.css" "$config_home/niri/tqq-windowfx.kdl"; then
            notify "Window borders could not be recolored. Check Matugen palette."
        fi
    fi
    pkill -SIGUSR2 -x waybar >/dev/null 2>&1 || true

    # Reload wallpaper-derived terminal themes without restarting shell sessions.
    # Kitty accepts SIGUSR1; Ghostty supports systemd user reload / SIGUSR2.
    # Only reload terminals with TQQ theme files installed.
    if [[ -f "$config_home/kitty/tqq.conf" ]]; then
        pkill -USR1 -u "$(id -u)" -x kitty >/dev/null 2>&1 || true
    fi
    if [[ -f "$config_home/ghostty/tqq.conf" ]]; then
        if ! (command -v systemctl >/dev/null 2>&1 &&
              systemctl --user reload app-com.mitchellh.ghostty.service >/dev/null 2>&1); then
            pkill -USR2 -u "$(id -u)" -x ghostty >/dev/null 2>&1 || true
        fi
    fi

    # Dunst reads its updated Matugen theme without blocking installation.
    if command -v dunstctl >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
        timeout 2s dunstctl reload >/dev/null 2>&1 || true
    fi
    notify "Wallpaper and desktop palette updated."
}

case "${1:-pick}" in
    --restore|restore)
        if [[ -r "$state_file" ]]; then
            IFS= read -r saved_image < "$state_file" || true
            wait_for_components=1
            [[ -n "${saved_image:-}" ]] && set_wallpaper "$saved_image"
        fi
        exit 0
        ;;
    --set|set)
        [[ $# -ge 2 ]] || { echo "Usage: $0 --set IMAGE" >&2; exit 2; }
        set_wallpaper "$2"
        exit
        ;;
    pick) ;;
    *) echo "Usage: $0 [pick|--restore|--set IMAGE]" >&2; exit 2 ;;
esac

for required in matugen python3; do
    if ! command -v "$required" >/dev/null 2>&1; then
        notify "Missing required command: $required"
        exit 1
    fi
done

if [[ ! -d "$wallpaper_dir" ]]; then
    notify "Wallpaper folder not found: $wallpaper_dir"
    exit 1
fi

mapfile -d '' wallpapers < <(
    find "$wallpaper_dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z
)

if ((${#wallpapers[@]} == 0)); then
    notify "No images found in $wallpaper_dir"
    exit 1
fi

if [[ ! -x "$picker" ]]; then
    notify "Wallpaper preview picker not found: $picker"
    exit 1
fi
# Escape is handled by the GTK picker itself. Mod+B now toggles that one picker.
# The lock prevents repeated presses from creating duplicate overlay windows.
if ! command -v flock >/dev/null 2>&1; then
    echo "Install util-linux (flock) for TQQ wallpaper toggle." >&2
    exit 1
fi
mkdir -p "$state_home"
exec 9>"$state_home/gallery-toggle.lock"
gallery_pid_file="$state_home/gallery-toggle.pid"
if ! flock -n 9; then
    # Another invocation is opening or waiting for the picker; ask it to close.
    for attempt in {1..30}; do
        owner=""
        if [[ -r "$gallery_pid_file" ]]; then
            IFS= read -r owner < "$gallery_pid_file" || true
        fi
        if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
            kill -USR1 "$owner" 2>/dev/null || true
            break
        fi
        sleep 0.025
    done
    exit 0
fi

gallery_closing=0
gallery_pid=0
close_gallery() {
    gallery_closing=1
    if (( gallery_pid > 0 )); then
        kill -TERM "$gallery_pid" 2>/dev/null || true
    fi
}
trap close_gallery USR1
printf '%s\n' "$" > "$gallery_pid_file"
selection_file="$(mktemp "$state_home/.gallery-result.XXXXXXXX")"
"$picker" "$wallpaper_dir" "$state_file" > "$selection_file" 9>&- &
gallery_pid=$!
if (( gallery_closing )); then
    kill -TERM "$gallery_pid" 2>/dev/null || true
fi
wait "$gallery_pid" || true
trap - USR1
selected="$(cat "$selection_file")"
rm -f -- "$selection_file" "$gallery_pid_file"
flock -u 9
exec 9>&-
# Close via Mod+B or Escape does not select/apply a wallpaper.
if (( gallery_closing )); then exit 0; fi
[[ -n "$selected" ]] || exit 0
set_wallpaper "$selected"
