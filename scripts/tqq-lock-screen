#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

if ! command -v quickshell >/dev/null 2>&1; then
    echo "Quickshell is not installed. Run ./install.sh --install-deps first." >&2
    exit 1
fi

# Keep failures diagnosable when the lock is launched via a Niri binding.
# Do not log passwords; only Quickshell process output is captured.
umask 077
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tqq-niri-rice"
mkdir -p "$state_dir"
exec quickshell --no-duplicate --config tqq-lock >>"$state_dir/lockscreen.log" 2>&1
